{
  // Worker de MAHAS MASSAGE. Los archivos de public/ se sirven por el binding ASSETS.
  // run_worker_first en true hace que el Worker atienda toda peticion antes que los estaticos,
  // necesario para inyectar el head en la Home y para redirigir la raiz por idioma.
  "name": "mahas-massage",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_USERS": "[\n {\n \"username\": \"prueba\",\n \"name\": \"Prueba\",\n \"salt\": \"rQj81R4TQ1NldAMGFZKLpA==\",\n \"hash\": \"erjPhaZxawmb2Vftg+SKF51txIiQ6x2dcERtMZSgIEU=\",\n \"iterations\": 210000\n }\n]",
    // Dominio canonico usado en canonical, hreflang, Open Graph y sitemaps
    "SITE_URL": "https://mahasmassage.com",
    // Solo el valor true permite indexar. Dejar en false hasta el lanzamiento
    "INDEXABLE": "false",
    // El valor false retira los precios del Schema.org. Cliente aprobo el catalogo
    // y sus precios el 2026-09-21; se activa en true
    "SCHEMA_INCLUDE_PRICES": "true"
  },
  // Dos namespaces de KV, cada uno con su propio id. Crear una sola vez cada uno con:
  //   npx wrangler kv namespace create CATALOG_KV
  //   npx wrangler kv namespace create BOOKINGS_KV
  // y reemplazar el TODO de cada binding por el id que devuelva su comando.
  //
  // CATALOG_KV   chat 4. Fuente unica del catalogo (clave catalog, la lista completa de
  //              experiencias) y contador de intentos fallidos de login del Admin (chat 5).
  //              Sembrar la clave catalog con el contenido de kv/catalog.seed.json.
  // BOOKINGS_KV  chat 6. Solicitudes de reserva en estado pending, sin disponibilidad real.
  "kv_namespaces": [
    { "binding": "CATALOG_KV", "id": "248fb35909924bebb604c06a9eb22b7e" },
    { "binding": "BOOKINGS_KV", "id": "4f67c413c4a44238b213410250114da5" }
  ],
  "observability": { "enabled": true }
  // Secretos, ninguno va aqui. Se definen con: npx wrangler secret put <NOMBRE>
  //
  // ADMIN_USERS            chat 5. JSON con un arreglo de usuarios (Silvia, Sergio) para el
  //                        login del Admin. Cada entrada sale de:
  //                        node scripts/hash-password.mjs una-contrasena
  // ADMIN_SESSION_SECRET   chat 5. Cadena aleatoria larga para firmar la cookie de sesion
  //                        del Admin. Generarla, por ejemplo, con: openssl rand -base64 48
  // ADMIN_KEY              chat 4. Opcional. Acceso de servicio para /api/admin/catalog y
  //                        /api/admin/bookings, alterno al login por persona.
  //
  // El secreto ADMIN_TOKEN del chat 6 ya no se usa: la lista de reservas se protege con la
  // misma guardia que el catalogo (src/admin/guard.js).
}
